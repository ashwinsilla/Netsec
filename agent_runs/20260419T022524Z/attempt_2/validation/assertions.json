{
  "assertions": [
    {
      "type": "config_contains",
      "pattern": "ip address virtual.*10\\.10\\.10\\.1/24",
      "description": "Verify anycast gateway IP 10.10.10.1/24 is configured as virtual IP on VLAN 10 SVI",
      "nodes": [
        "dc1-leaf1a",
        "dc1-leaf1b",
        "dc1-leaf1c",
        "dc1-leaf2a",
        "dc1-leaf2b",
        "dc1-leaf2c"
      ]
    },
    {
      "type": "config_contains",
      "pattern": "interface Vlan10",
      "description": "Verify VLAN 10 SVI interface exists on leaf nodes",
      "nodes": [
        "dc1-leaf1a",
        "dc1-leaf1b",
        "dc1-leaf1c",
        "dc1-leaf2a",
        "dc1-leaf2b",
        "dc1-leaf2c"
      ]
    },
    {
      "type": "config_contains",
      "pattern": "vlan.*10",
      "description": "Verify VLAN 10 is defined in the VLAN database on leaf nodes",
      "nodes": [
        "dc1-leaf1a",
        "dc1-leaf1b",
        "dc1-leaf1c",
        "dc1-leaf2a",
        "dc1-leaf2b",
        "dc1-leaf2c"
      ]
    },
    {
      "type": "batfish_route_exists",
      "node_regex": "dc1-leaf(1a|1b|1c|2a|2b|2c)",
      "vrf": "default",
      "prefix": "10.10.10.0/24",
      "description": "Verify 10.10.10.0/24 subnet is present in the default VRF routing table on leaf nodes"
    }
  ]
}
