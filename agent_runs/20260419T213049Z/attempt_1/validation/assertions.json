{
  "assertions": [
    {
      "type": "config_contains",
      "pattern": "vlan 60",
      "description": "VLAN 60 should be defined on all leaf nodes",
      "nodes": [
        "dc1-leaf1a",
        "dc1-leaf1b",
        "dc1-leaf1c",
        "dc1-leaf2a",
        "dc1-leaf2b",
        "dc1-leaf2c"
      ]
    },
    {
      "type": "config_contains",
      "pattern": "interface Vlan60",
      "description": "SVI for VLAN 60 should exist on all leaf nodes",
      "nodes": [
        "dc1-leaf1a",
        "dc1-leaf1b",
        "dc1-leaf1c",
        "dc1-leaf2a",
        "dc1-leaf2b",
        "dc1-leaf2c"
      ]
    },
    {
      "type": "config_contains",
      "pattern": "ip address virtual.*192\\.168\\.60\\.1/24",
      "description": "Anycast gateway IP 192.168.60.1/24 should be configured on VLAN 60 SVI on all leaf nodes",
      "nodes": [
        "dc1-leaf1a",
        "dc1-leaf1b",
        "dc1-leaf1c",
        "dc1-leaf2a",
        "dc1-leaf2b",
        "dc1-leaf2c"
      ]
    },
    {
      "type": "config_contains",
      "pattern": "name.*VLAN60",
      "description": "VLAN 60 should have the name VLAN60 defined on all leaf nodes",
      "nodes": [
        "dc1-leaf1a",
        "dc1-leaf1b",
        "dc1-leaf1c",
        "dc1-leaf2a",
        "dc1-leaf2b",
        "dc1-leaf2c"
      ]
    },
    {
      "type": "batfish_route_exists",
      "node_regex": "dc1-leaf1a|dc1-leaf1b|dc1-leaf1c|dc1-leaf2a|dc1-leaf2b|dc1-leaf2c",
      "vrf": "default",
      "prefix": "192.168.60.0/24",
      "description": "Route for 192.168.60.0/24 should exist in the routing table on all leaf nodes"
    }
  ]
}
